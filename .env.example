# Back. Nunca commite valores reais; o .env local é ignorado pelo git.
# API — Supabase: Project Settings → API
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_ANON_KEY=""
# Só no servidor: ignora todas as políticas RLS (rules/secrets.md)
SUPABASE_SERVICE_ROLE_KEY=""

# Postgres — Supabase: Project Settings → Database
# Transaction pooler (runtime do Prisma na Vercel serverless)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session pooler (introspecção: prisma db pull)
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Origem do front permitida no CORS (URL do deploy do front, sem barra final)
FRONT_ORIGIN="https://<seu-front>.vercel.app"
