{
  "name": "emprest-ai-back",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "up": "npm run db:up && npm run build && npm start",
    "db:up": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,mailpit,realtime,postgres-meta,supavisor",
    "db:down": "supabase stop",
    "db:reset": "supabase db reset",
    "db:pull": "prisma db pull && prisma generate",
    "postinstall": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\" && prisma generate",
    "test": "jest --config jest.config.cjs",
    "seed:local": "node scripts/seed-dados-iniciais.mjs --local",
    "seed:dados-iniciais": "node scripts/seed-dados-iniciais.mjs",
    "imagens:preparar": "node skills/imagens-equipamentos/scripts/preparar-imagens.mjs",
    "imagens:enviar:local": "node skills/imagens-equipamentos/scripts/enviar-imagens.mjs --local",
    "imagens:enviar": "node skills/imagens-equipamentos/scripts/enviar-imagens.mjs",
    "imagens:candidatos": "node skills/imagens-equipamentos/scripts/candidatos-imagens.mjs",
    "imagens:escolher": "node skills/imagens-equipamentos/scripts/escolher-imagem.mjs",
    "check:specs": "node scripts/checar-specs.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "sharp": "0.35.5",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
